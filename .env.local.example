# Copiar a .env.local para desarrollo local. Ver HANDOFF.md para más detalle
# de cada variable.

POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:5432/playbook
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (login de lectores, auth.ts) — credenciales del OAuth client
# creado en Google Cloud Console. Redirect URI autorizado debe ser
# <origin>/api/auth/callback/google (uno por entorno: localhost y producción).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend (solo invitaciones de equipo a editores, lib/email.ts — ya no se usa
# para el login de lectores, que pasó a Google OAuth arriba). Necesita un
# dominio verificado en Resend para enviar a direcciones arbitrarias; con
# onboarding@resend.dev sin verificar solo llegan correos a la casilla dueña
# de la cuenta de Resend.
RESEND_API_KEY=
EMAIL_FROM="Playbook <onboarding@resend.dev>"

# Vercel Blob (subida de imágenes en el editor)
BLOB_READ_WRITE_TOKEN=

# Webhook de Make.com (api/update-articles)
PLAYBOOK_SECRET=

# GA4 Data API (lectura de pageviews para el módulo "Más leídas" de portada,
# lib/ga4.ts) — credencial de cuenta de servicio, separada del Measurement ID
# de GA4 del lado del cliente (ver GA4_MEASUREMENT_ID abajo). El service
# account necesita rol Viewer en la propiedad de GA4, además de tener
# habilitada la Analytics Data API en su proyecto de Google Cloud.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_EMAIL=
GA4_SERVICE_ACCOUNT_PRIVATE_KEY=

# Google Sheets (lib/google-sheets.ts) — reutiliza el mismo service account
# de arriba (GA4_SERVICE_ACCOUNT_EMAIL/PRIVATE_KEY), pero necesita dos pasos
# de setup propios, ninguno es código: (1) habilitar la Google Sheets API en
# el mismo proyecto de Google Cloud (la Analytics Data API de GA4 es una API
# distinta), y (2) compartir la hoja de cálculo con el correo del service
# account como Editor (igual que compartirla con cualquier persona). Sin
# READERS_SHEET_ID configurada, lib/google-sheets.ts no hace nada (no
# bloquea el registro de lectores). El ID es la cadena larga en la URL de la
# hoja: docs.google.com/spreadsheets/d/<este-id>/edit
READERS_SHEET_ID=

# Protege app/api/cron/sync-readers-sheet (re-sincroniza la hoja completa
# todos los días, ver vercel.json's `crons`). Vercel firma automáticamente
# cada invocación programada con `Authorization: Bearer <CRON_SECRET>` en
# cuanto esta variable existe -- no hay nada más que configurar del lado de
# Vercel, solo poner un valor random acá (ej. `openssl rand -hex 32`).
CRON_SECRET=

# GA4 Measurement ID del lado del cliente (envía eventos DE pageview, no los
# lee — eso es GA4_PROPERTY_ID arriba). No es secreto (viaja en el HTML de
# cualquier página pública), pero se lee server-side en app/(public)/layout.tsx
# igual que el resto de las variables de este archivo, no como NEXT_PUBLIC_*.
# Solo carga en rutas públicas, nunca en /admin. Valor real confirmado por el
# equipo: G-KVE4HF75TF (ver components/analytics/GoogleAnalytics.tsx).
# Reemplaza a G-0CG7JMK8RZ desde el 2026-08-07: al rotar la propiedad hay
# que actualizar la variable en Vercel (Project Settings -> Environment
# Variables, los tres entornos) además de acá, porque el valor NO vive en
# el código -- el componente arma el snippet de gtag.js con lo que reciba.
GA4_MEASUREMENT_ID=

# Vercel Web Analytics API (lib/vercel-analytics.ts, panel de analítica del
# admin — Fase 4). VERCEL_PROJECT_ID normalmente la inyecta Vercel solo como
# System Environment Variable; TEAM_ID/TEAM_SLUG solo hacen falta si el
# proyecto pertenece a un equipo, no a una cuenta personal.
VERCEL_ANALYTICS_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_TEAM_SLUG=

# Google AdSense (components/ads/AdSlot.tsx, lib/adsense.ts). Sin
# ADSENSE_CLIENT_ID, cada AdSlot no renderiza nada (ni siquiera espacio
# reservado) -- estado actual del sitio, sin red de ads conectada todavía.
# Una vez que exista una cuenta de AdSense aprobada para el dominio:
# ADSENSE_CLIENT_ID es el publisher ID completo (ca-pub-XXXXXXXXXXXXXXXX,
# visible en cualquier página ya en vivo, no es secreto). Los seis
# ADSENSE_SLOT_* son el ID del ad unit creado en el dashboard de AdSense
# para cada posición del sitio -- cada uno se puede completar por separado
# a medida que se crean, sin tocar código: el slot correspondiente se
# activa solo apenas su variable tiene valor (y ADSENSE_CLIENT_ID también
# está seteado). No es necesario tener los seis para que arranque alguno.
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_LEADERBOARD_HOME=
ADSENSE_SLOT_INLINE_FEED=
ADSENSE_SLOT_RAIL_HOME=
ADSENSE_SLOT_INLINE_MID_EDITORIAL=
ADSENSE_SLOT_INLINE_ARTICLE=
ADSENSE_SLOT_VERTICAL_SPONSOR_INFINITAS=

# (ADMIN_USERS fue eliminada.) El roster del equipo editorial vive en
# drizzle/0005_editorial_team_accounts.sql — solo hashes bcrypt, se aplica
# solo en el deploy de producción. Para rotar una contraseña:
#   npm run db:reset-editor-password -- <usuario>
# La contraseña nueva se imprime una sola vez y nunca se guarda en texto
# plano en ningún lado.
