# Copiar a .env.local para desarrollo local. Ver HANDOFF.md para más detalle
# de cada variable.

POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:5432/playbook
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (login de lectores, auth.ts) — credenciales del OAuth client
# creado en Google Cloud Console. Redirect URI autorizado debe ser
# <origin>/api/auth/callback/google (uno por entorno: localhost y producción).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend (solo invitaciones de equipo a editores, lib/email.ts — ya no se usa
# para el login de lectores, que pasó a Google OAuth arriba). Necesita un
# dominio verificado en Resend para enviar a direcciones arbitrarias; con
# onboarding@resend.dev sin verificar solo llegan correos a la casilla dueña
# de la cuenta de Resend.
RESEND_API_KEY=
EMAIL_FROM="Playbook <onboarding@resend.dev>"

# Vercel Blob (subida de imágenes en el editor)
BLOB_READ_WRITE_TOKEN=

# Webhook de Make.com (api/update-articles)
PLAYBOOK_SECRET=

# GA4 Data API (lectura de pageviews para el módulo "Más leídas" de portada,
# lib/ga4.ts) — credencial de cuenta de servicio, separada del Measurement ID
# de GA4 del lado del cliente (ver GA4_MEASUREMENT_ID abajo). El service
# account necesita rol Viewer en la propiedad de GA4, además de tener
# habilitada la Analytics Data API en su proyecto de Google Cloud.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_EMAIL=
GA4_SERVICE_ACCOUNT_PRIVATE_KEY=

# GA4 Measurement ID del lado del cliente (envía eventos DE pageview, no los
# lee — eso es GA4_PROPERTY_ID arriba). No es secreto (viaja en el HTML de
# cualquier página pública), pero se lee server-side en app/(public)/layout.tsx
# igual que el resto de las variables de este archivo, no como NEXT_PUBLIC_*.
# Solo carga en rutas públicas, nunca en /admin. Valor real confirmado por el
# equipo: G-0CG7JMK8RZ (ver components/analytics/GoogleAnalytics.tsx).
GA4_MEASUREMENT_ID=

# Vercel Web Analytics API (lib/vercel-analytics.ts, panel de analítica del
# admin — Fase 4). VERCEL_PROJECT_ID normalmente la inyecta Vercel solo como
# System Environment Variable; TEAM_ID/TEAM_SLUG solo hacen falta si el
# proyecto pertenece a un equipo, no a una cuenta personal.
VERCEL_ANALYTICS_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_TEAM_SLUG=

# (ADMIN_USERS fue eliminada.) El roster del equipo editorial vive en
# drizzle/0005_editorial_team_accounts.sql — solo hashes bcrypt, se aplica
# solo en el deploy de producción. Para rotar una contraseña:
#   npm run db:reset-editor-password -- <usuario>
# La contraseña nueva se imprime una sola vez y nunca se guarda en texto
# plano en ningún lado.
