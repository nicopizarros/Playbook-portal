# Python bytecode from .claude/skills tooling
__pycache__/

# Claude SEO isolated runtime (generated by ./bin/claude-seo setup)
.claude/skills/seo/.venv/
.claude/skills/seo/ms-playwright/
.claude/skills/seo/runtime-state.json

# graphify writes a dated snapshot of the previous curated graph on every
# `graphify update`. Git history already holds that state, so the backup is
# pure bloat (~2.3MB a run) and has never been tracked.
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# graphify rewrites cache/last_query_stamp on every read-only `graphify
# query`, so simply ORIENTING in the graph left the tree dirty and tripped
# the commit-check hook on sessions that changed no code. Tracking it buys
# nothing either: the CLI reads the file's MTIME (_query_stamp_fresh), which
# git does not preserve, and both its writer and reader are fail-silent, so a
# fresh clone without the file just reports "not fresh". The AST cache beside
# it stays tracked — that one is real content that saves a rebuild.
graphify-out/cache/last_query_stamp
.scratch/
