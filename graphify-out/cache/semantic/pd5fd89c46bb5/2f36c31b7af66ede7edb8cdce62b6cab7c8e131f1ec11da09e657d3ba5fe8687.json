{"nodes": [{"id": "styles_components", "label": "styles/components.css .tag-mini.industry-shots", "file_type": "code", "source_file": ".claude/skills/publish-sourced-article/references/ingestion.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_publish_sourced_article_references_ingestion_read_primary_source", "label": "Step 1: read the primary source (one link, one article)", "file_type": "concept", "source_file": ".claude/skills/publish-sourced-article/references/ingestion.md", "source_location": "Step 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_publish_sourced_article_references_ingestion_cross_reference_coverage", "label": "Step 2: cross-reference other coverage (mandatory)", "file_type": "concept", "source_file": ".claude/skills/publish-sourced-article/references/ingestion.md", "source_location": "Step 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verification, enrichment and independence: a Playbook piece built from a single competitor's article reads as a close paraphrase of that one competitor. It becomes movement 2 of the four-movement structure."}, {"id": "_claude_skills_publish_sourced_article_references_ingestion_find_co_issuer_postings", "label": "Find each primary co-issuer's own posting", "file_type": "concept", "source_file": ".claude/skills/publish-sourced-article/references/ingestion.md", "source_location": "Step 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Fuentes line credits who said it, not who reported it, so every joint signatory's own URL is what the line wants. A site behind bot protection must be reported, not silently dropped."}, {"id": "_claude_skills_publish_sourced_article_references_ingestion_handling_wire_copy", "label": "Handling wire copy (pacing does not survive translation)", "file_type": "rationale", "source_file": ".claude/skills/publish-sourced-article/references/ingestion.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A Reuters or AP paragraph is built to be lifted whole, so a faithful translation imports its breaking-news cadence with its facts; Playbook's register is a calm business brief even when the story is dramatic."}, {"id": "_claude_skills_publish_sourced_article_references_ingestion_asymmetries_in_reactions", "label": "Look for asymmetries in how parties reacted", "file_type": "concept", "source_file": ".claude/skills/publish-sourced-article/references/ingestion.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Substance objections versus procedural complaints are different things; drawing the distinction is what makes a piece Playbook's own take rather than a translated wire summary."}, {"id": "_claude_skills_publish_sourced_article_references_ingestion_rewrite_not_paraphrase", "label": "A rewrite, not a paraphrase", "file_type": "rationale", "source_file": ".claude/skills/publish-sourced-article/references/ingestion.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The mechanical style rules matter more in this funnel because a third-party article is being rewritten rather than expanded, and a rewrite reaching for the same rhetorical shapes is exactly what reads as a machine paraphrase."}, {"id": "_claude_skills_publish_sourced_article_references_ingestion_fixed_product_routing", "label": "Fixed product routing: Noticias / industry-shots", "file_type": "concept", "source_file": ".claude/skills/publish-sourced-article/references/ingestion.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A third-party wire pickup reads as a news brief, not a Playbook-branded opinion piece. There is no separate 'wire story' entry in KNOWN_SOURCES, so reusing industry-shots is the pragmatic way to get the Noticias label without adding a taxonomy value."}, {"id": "_claude_skills_publish_sourced_article_references_ingestion_resultados_for_filings", "label": "Earnings release or filing means the Resultados device", "file_type": "concept", "source_file": ".claude/skills/publish-sourced-article/references/ingestion.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Added 2026-08-11 on publisher feedback that a quarterly report deserved better than a lone Cifra clave; this funnel gets company results more than any other."}], "edges": [{"source": "_claude_skills_publish_sourced_article_references_ingestion_read_primary_source", "target": "_claude_skills_publish_sourced_article_references_ingestion_cross_reference_coverage", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/publish-sourced-article/references/ingestion.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_publish_sourced_article_references_ingestion_read_primary_source", "target": "_claude_skills_publish_newsletter_references_overlap_check_the_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/publish-sourced-article/references/ingestion.md", "source_location": "Step 1", "weight": 1.0}, {"source": "_claude_skills_publish_sourced_article_references_ingestion_read_primary_source", "target": "_claude_skills_publish_newsletter_references_voice_and_style_prior_coverage_backlink", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/publish-sourced-article/references/ingestion.md", "source_location": "Step 1", "weight": 1.0}, {"source": "_claude_skills_publish_sourced_article_references_ingestio