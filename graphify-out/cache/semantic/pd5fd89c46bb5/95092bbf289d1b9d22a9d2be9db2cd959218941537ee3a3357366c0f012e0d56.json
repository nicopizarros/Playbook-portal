{"nodes": [{"id": "_claude_skills_publish_sourced_article_references__governance_single_source_of_truth", "label": "Single source of truth (never fork a rule into a skill-local file)", "file_type": "rationale", "source_file": ".claude/skills/publish-sourced-article/references/_GOVERNANCE.md", "source_location": "1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A rule that exists in two places has already started drifting; the two skills stopped being one masthead the moment it did."}, {"id": "_claude_skills_publish_sourced_article_references__governance_truncation_incident", "label": "Why the shared tree exists (2026-08-11 truncation incident)", "file_type": "rationale", "source_file": ".claude/skills/publish-sourced-article/references/_GOVERNANCE.md", "source_location": "1b", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A session editing the then-monolithic publish-newsletter/SKILL.md truncated it by ~1,200 lines while intending a narrow change; the Fuentes line, the Noticias rename and the dead playbook source key all silently reverted with it. A 1,300-line file nobody can diff at a glance is what made that invisible."}, {"id": "_claude_skills_publish_sourced_article_references__governance_place_before_you_create", "label": "Place before you create (file ownership table)", "file_type": "concept", "source_file": ".claude/skills/publish-sourced-article/references/_GOVERNANCE.md", "source_location": "2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A seventh file is a last resort; a rule that seems not to fit anywhere is usually a rule about an existing topic stated at the wrong altitude."}, {"id": "_claude_skills_publish_sourced_article_references__governance_one_rule_one_home", "label": "One rule, one home (cross-reference, never copy)", "file_type": "rationale", "source_file": ".claude/skills/publish-sourced-article/references/_GOVERNANCE.md", "source_location": "3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Restating a rule 'for convenience' is how a per-tier paragraph range gets reintroduced after being deliberately removed."}, {"id": "_claude_skills_publish_sourced_article_references__governance_date_it_and_name_its_source", "label": "Date it and name its source", "file_type": "rationale", "source_file": ".claude/skills/publish-sourced-article/references/_GOVERNANCE.md", "source_location": "4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "These files get re-litigated and an undated rule loses to a dated one; a superseding directive replaces the old one rather than layering on top."}, {"id": "_claude_skills_publish_sourced_article_references__governance_convergence_check", "label": "Every change ships with a convergence check", "file_type": "concept", "source_file": ".claude/skills/publish-sourced-article/references/_GOVERNANCE.md", "source_location": "5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run both skills on comparable test articles, diff the outputs and confirm zero divergence beyond what ingestion legitimately causes, and confirm the entry-token cost has not regressed."}, {"id": "_claude_skills_publish_sourced_article_references__governance_report_in_six_phases", "label": "Report in six phases", "file_type": "concept", "source_file": ".claude/skills/publish-sourced-article/references/_GOVERNANCE.md", "source_location": "6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_publish_sourced_article_references__governance_syncing", "label": "Syncing (SYNC_PATHS covers skills and playbook-editorial)", "file_type": "concept", "source_file": ".claude/skills/publish-sourced-article/references/_GOVERNANCE.md", "source_location": "7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If a future refactor moves shared content again, update SYNC_PATHS in the same commit or the feedback loop silently stops carrying it."}], "edges": [{"source": "_claude_skills_publish_sourced_article_references__governance_truncation_incident", "target": "_claude_skills_publish_sourced_article_references__governance_single_source_of_truth", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/publish-sourced-article/references/_GOVERNANCE.md", "source_location": "1b", "weight": 1.0}, {"source": "_claude_skills_publish_sourced_article_references__governance_single_source_of_truth", "target": "_claude_skills_publish_sourced_article_references__governance_place_before_you_create", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/publish-sourced-article/references/_GOVERNANCE.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_publish_sourced_article_references__governance_single_source_of_truth", "target": "_claude_skills_publish_sourced_article_references__governance_one_rule_one_home", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/publish-sourced-article/references/_GOVERNANCE.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_publish_sourced_article_references__governance_single_source_of_truth", "target": "_claude_skills_publish_sourced_article_skill_shared_vs_own_symlinks", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/publish-sourced-article/references/_GOVERNANCE.md", "source_location": "1", "weight": 1.0}, {"source": "_claude_skills_publish_sourced_article_references__governance_convergence_check", "target": "scripts_check_voice", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_